# Installed to /etc/systemd/system by scripts/install.sh.
# At boot: when neither a WLAN nor a cable connects within 90 s, the Pi opens
# the WLAN "SpoolmanScale-Pro-Setup" so it can be reached and set up from a
# phone. Only at boot, never while running: a WLAN that drops for a moment
# must not turn the Pi into an access point. The logic is the helper's verb
# setup-ap-if-offline (system/host-helper.sh).
[Unit]
Description=SpoolmanScale Pro: setup WLAN when the Pi has no network
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
# simple, not oneshot: its wait of up to 90 s must not hold up the boot.
Type=simple
ExecStart=/usr/local/libexec/spoolmanscale-pro/host-helper setup-ap-if-offline
RuntimeMaxSec=180

[Install]
WantedBy=multi-user.target
