# Installed to /etc/systemd/system by scripts/install.sh.
[Unit]
Description=SpoolmanScale Pro
Documentation=https://github.com/Niko11111/SpoolmanScalePro-Pi
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=spoolmanscale
Group=spoolmanscale
Environment=SSPRO_DATA_DIR=/var/lib/spoolmanscale-pro
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/spoolmanscale-pro/current
ExecStart=/opt/spoolmanscale-pro/current/.venv/bin/python -m spoolmanscale_pro --port 80
# Port 80 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# No NoNewPrivileges and no ProtectSystem here: both would also bind the
# root helper started through sudo (it sets the clock and saves it to /etc).
PrivateTmp=true
ProtectHome=true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
